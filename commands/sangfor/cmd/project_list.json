{
  "name": "sangfor.project_list",
  "platform": "sangfor",
  "description": "深信服安服数字化服务平台(sdsp)项目列表查询/导出。支持按项目名称(keyword)模糊过滤；默认导出前 15 条，字段含项目名称、项目经理、客户名称、客户行业、项目级别、产品线、创建时间。",
  "riskLevel": "low",
  "sessionRef": "prelogged-sangfor-atrust-session",
  "parameters": {
    "projectName": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "项目名称过滤关键词，映射到接口 keyword 字段。后端为模糊匹配，同时命中 项目名/PM/客户名/项目编号/订单号/审批单号 等。留空返回全部。"
    },
    "limit": {
      "type": "number",
      "required": false,
      "default": 15,
      "description": "返回数量上限。接口单页上限实测 100 可用、200 被拒（code 1003）；默认 15。拉取超过单页数量需 offset 分页（见 learnedFrom.notes）。"
    },
    "offset": {
      "type": "number",
      "required": false,
      "default": 0,
      "description": "分页偏移量，按 offset 递增翻页。"
    },
    "outputPath": {
      "type": "string",
      "required": false,
      "default": "runs/sangfor-projects.xlsx",
      "description": "Excel 输出路径。"
    }
  },
  "dataSource": {
    "id": "projects",
    "type": "http_json",
    "title": "深信服 sdsp 项目列表 {{params.projectName}}",
    "steps": [
      {
        "id": "fetch_projects",
        "request": {
          "method": "POST",
          "url": "https://sdsp.atrust.sangfor.com/pms/v1/project/project-list",
          "headers": {
            "content-type": "application/json",
            "accept": "application/json, text/javascript, */*; q=0.01",
            "x-requested-with": "XMLHttpRequest",
            "x-csrf-token": "{{session.csrfToken}}"
          },
          "body": {
            "offset": "{{params.offset}}",
            "limit": "{{params.limit}}",
            "is_first": 0,
            "keyword": "{{params.projectName}}",
            "project_status": [],
            "time_arrange_list": [],
            "project_level": [],
            "market_id": [],
            "cost_abnormal": [],
            "service_bill": [],
            "customer_type": [],
            "project_scene": [],
            "hw_type_list": [],
            "customer_industry": [],
            "product_line": [],
            "subcontract_type_list": [],
            "is_tid": 0,
            "sign_type": 0,
            "create_time_list": [],
            "source": [],
            "approval_time": [],
            "is_stamped_accept_report": [],
            "acceptance_time": [],
            "white_customers": 0,
            "pro_sig_time": [],
            "customer_group": -1,
            "af_amount": [
              "",
              ""
            ],
            "is_participate": 0,
            "is_responsible": 0,
            "order_project_level_name": 0,
            "order_pm_name": 0,
            "is_exclude": 0,
            "is_temporary": 0,
            "repayment_rate": [],
            "sub_settle_status": 0
          },
          "expect": {
            "bodyCode": 0
          }
        },
        "collect": {
          "limit": "{{params.limit}}",
          "initialCursor": 0,
          "maxPages": 1,
          "itemsPath": "data.list",
          "totalPath": "data.total",
          "map": [
            {
              "key": "projectName",
              "path": "project_name"
            },
            {
              "key": "pmName",
              "path": "pm_name"
            },
            {
              "key": "customerName",
              "path": "customer_name"
            },
            {
              "key": "customerIndustry",
              "path": "customer_industry"
            },
            {
              "key": "projectLevel",
              "path": "project_level_name"
            },
            {
              "key": "productLine",
              "path": "product_line_name"
            },
            {
              "key": "createTime",
              "path": "project_create_time",
              "transform": "msTime"
            }
          ]
        }
      }
    ]
  },
  "output": {
    "capability": "export_excel",
    "path": "{{params.outputPath}}",
    "title": "深信服 sdsp 项目列表 {{params.projectName}}",
    "source": "projects.rows",
    "columnsTemplate": "./templates/project.columns.json"
  },
  "execution": {
    "prefer": [
      "api"
    ],
    "api": {
      "method": "POST",
      "url": "https://sdsp.atrust.sangfor.com/pms/v1/project/project-list",
      "headers": {
        "content-type": "application/json",
        "accept": "application/json, text/javascript, */*; q=0.01",
        "x-requested-with": "XMLHttpRequest",
        "x-csrf-token": "{{session.csrfToken}}"
      },
      "body": {
        "offset": "{{params.offset}}",
        "limit": "{{params.limit}}",
        "keyword": "{{params.projectName}}",
        "is_first": 0,
        "customer_group": -1,
        "af_amount": [
          "",
          ""
        ]
      }
    }
  },
  "learnedFrom": {
    "url": "https://sdsp.atrust.sangfor.com/sdsp/index.html#/overview/project/all",
    "observedAt": "2026-06-02",
    "provider": "webbridge_real_session_observation",
    "notes": [
      "项目列表接口：POST https://sdsp.atrust.sangfor.com/pms/v1/project/project-list，请求体为 JSON，返回 {code:0, data:{total, list:[...], custom_info:{...}}}。",
      "项目名称过滤=请求体 keyword 字段（实测在搜索框输入会带 keyword，后端模糊匹配 project_name/customer_name/pm_name 等）；本 command 将 keyword 参数化为 projectName。",
      "分页为 offset/limit 递增式，响应不含 next 游标；单页 limit 实测最大 100（>=200 返回 code 1003）。total 随 keyword 变化：空 keyword=2576（全量），keyword=【MSS测试】=1168。",
      "行对象关键字段：project_name, project_id, pm_name, customer_name, customer_industry, customer_province, project_level_name, project_status, product_line_name, service_bill_name, team, project_create_time（13 位毫秒时间戳，需格式化为 datetime，本 command 用 map.transform=msTime）。",
      "鉴权：会话 cookie（含 httpOnly session，由 aTrust 零信任网关维持）+ 请求头 X-CSRF-Token（值取自 csrf_token cookie）。Node 端裸 fetch 无登录态会 401/403。",
      "实测验证（2026-06-02）：经 webbridge 携带 aTrust 会话真实分页调用，keyword=【MSS测试】拉取 1168 条，经项目 exportRows(export_excel) 导出 runs/sangfor-projects.xlsx 成功；project_create_time 确认为 13 位毫秒时间戳。",
      "执行引擎已支持 POST JSON body 与 offset/limit 分页；真实执行仍依赖已登录 aTrust 会话 cookie 与 X-CSRF-Token。"
    ]
  },
  "acceptance": {
    "version": "1.0",
    "evidenceRequired": true,
    "criteria": [
      {
        "id": "exported_file",
        "type": "file_exists",
        "description": "导出的 Excel 文件已生成（按 output.path）。"
      },
      {
        "id": "has_rows",
        "type": "data_contains",
        "description": "至少导出 1 条项目记录，且关键字段列已映射。",
        "expect": {
          "minCount": 1,
          "requiredColumns": [
            "projectName",
            "pmName",
            "customerName",
            "customerIndustry",
            "projectLevel",
            "productLine",
            "createTime"
          ]
        }
      },
      {
        "id": "keyword_filtered",
        "type": "manual_check",
        "description": "导出的项目名称均包含查询关键词，由执行 Agent 核验并回填 evidence。"
      }
    ]
  },
  "successCriteria": [
    "能按 projectName(keyword) 过滤项目列表。",
    "能解析 data.list 并映射为 项目名称/项目经理/客户名称/客户行业/项目级别/产品线/创建时间 列。",
    "默认 limit=15，只读取项目列表数据，不提交任何写操作。",
    "导出的 Excel 表头来自 ./templates/project.columns.json。"
  ],
  "checks": [
    "dry-run 能展示 POST /pms/v1/project/project-list 计划，且 body.keyword 已替换为 projectName。",
    "字段映射覆盖 project_name/pm_name/customer_name 等列模板字段。",
    "只读 read-only，不含写操作。"
  ],
  "failureCases": [
    "未登录或 aTrust 会话过期，接口返回 401/403。",
    "缺少 X-CSRF-Token 头或 csrf_token 与会话不匹配，接口校验失败。",
    "运行环境未注入有效会话 Cookie 或 CSRF Token，导致接口无法授权。",
    "接口字段结构调整导致映射失败。"
  ],
  "naturalLanguage": {
    "intent": "查询/导出深信服 sdsp 项目列表，支持按项目名称过滤。",
    "aliases": [
      "深信服项目列表",
      "sdsp 项目列表",
      "安服项目列表导出",
      "sangfor project list"
    ],
    "match": {
      "all": [
        "项目"
      ],
      "any": [
        "深信服",
        "sdsp",
        "sangfor",
        "安服",
        "atrust"
      ],
      "verbs": [
        "列表",
        "查询",
        "导出",
        "获取",
        "过滤",
        "搜索"
      ]
    },
    "extract": {
      "projectName": {
        "type": "after",
        "pattern": "(?:项目名称?|项目名|关键词|搜索)\\s*(?:是|为|=|:|：|包含)?\\s*([^，。；,;]+)",
        "marker": [
          "项目名称",
          "项目名",
          "关键词",
          "搜索"
        ],
        "stop": [
          "，",
          "。",
          "；",
          ",",
          ";",
          "/\\s(?:前|最多|limit|数量|输出|保存|导出到|output)\\s/i"
        ],
        "cleanup": "sangforProjectName"
      },
      "limit": {
        "type": "number",
        "pattern": "(?:前|最多|limit|数量)\\s*[:：=]?\\s*(\\d+)",
        "default": 15
      },
      "outputPath": {
        "type": "regex",
        "pattern": "(?:输出|保存|导出到|output)\\s*(?:到|为|=|:|：)?\\s*([^\\s，。；,;]+\\.xlsx)",
        "default": "runs/sangfor-projects.xlsx"
      }
    },
    "examples": [
      "导出深信服 sdsp 项目列表，项目名称包含 人民日报",
      "查询 sangfor 项目列表 前15 条，关键词 攻防演练，输出 runs/projects.xlsx"
    ]
  },
  "runtime": {
    "requiresAuth": true,
    "auth": {
      "type": "browser_session_cookie",
      "sessionRef": "prelogged-sangfor-atrust-session",
      "csrfToken": "csrf_token cookie -> x-csrf-token header"
    },
    "unauthorizedHint": "需要已登录的 aTrust/sdsp 浏览器会话；401/403 时请先刷新登录态并注入 cookie 与 csrf_token。"
  }
}
