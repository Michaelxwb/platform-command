{
  "name": "github.list_commits",
  "platform": "github",
  "description": "GitHub 场景实测：读取指定公开仓库某分支的提交列表。",
  "riskLevel": "low",
  "sessionRef": "prelogged-github-browser-profile",
  "parameters": {
    "owner": {
      "type": "string",
      "required": false,
      "default": "Michaelxwb",
      "description": "仓库 owner。"
    },
    "repo": {
      "type": "string",
      "required": false,
      "default": "platform-command",
      "description": "仓库名。"
    },
    "branch": {
      "type": "string",
      "required": false,
      "default": "master",
      "description": "分支名。"
    }
  },
  "execution": {
    "prefer": [
      "api",
      "ui"
    ],
    "workflow": {
      "version": "2.0",
      "steps": [
        {
          "id": "commits_api",
          "type": "api",
          "description": "调用 GitHub Commits API 读取提交列表。",
          "request": {
            "method": "GET",
            "url": "https://api.github.com/repos/{{params.owner}}/{{params.repo}}/commits?sha={{params.branch}}&per_page=10",
            "headers": {
              "Accept": "application/vnd.github+json",
              "User-Agent": "platform-command-scene-test"
            },
            "successWhen": [
              "status < 400"
            ]
          },
          "extract": {
            "firstSha": "$[0].sha",
            "firstMessage": "$[0].commit.message"
          }
        },
        {
          "id": "commits_page",
          "type": "ui",
          "description": "打开仓库 commits 页面，确认提交历史可见。",
          "ui": {
            "actions": [
              {
                "action": "goto",
                "url": "https://github.com/{{params.owner}}/{{params.repo}}/commits/{{params.branch}}"
              },
              {
                "action": "assert",
                "target": "body",
                "contains": "Commits"
              }
            ]
          }
        }
      ]
    }
  },
  "successCriteria": [
    "Commits API 返回 200。",
    "至少能读取提交列表或页面可访问。",
    "branch 参数已被带入 API/UI。"
  ],
  "failureCases": [
    "分支不存在。",
    "仓库不存在或无权限。",
    "GitHub API 限流。"
  ],
  "naturalLanguage": {
    "aliases": [
      "GitHub commits",
      "GitHub 提交记录",
      "GitHub 提交历史"
    ],
    "match": {
      "all": [
        "github"
      ],
      "any": [
        "commit",
        "commits",
        "提交",
        "提交记录",
        "提交历史"
      ],
      "verbs": [
        "查看",
        "列出",
        "读取",
        "查询",
        "看",
        "最近",
        "list",
        "show"
      ]
    },
    "extract": {
      "owner": {
        "type": "regex",
        "pattern": "([A-Za-z0-9_.-]+)\\/([A-Za-z0-9_.-]+)",
        "group": 1
      },
      "repo": {
        "type": "regex",
        "pattern": "([A-Za-z0-9_.-]+)\\/([A-Za-z0-9_.-]+)",
        "group": 2
      },
      "branch": {
        "type": "regex",
        "pattern": "(?:分支|branch)\\s*(?:是|为|=|:|：)?\\s*([A-Za-z0-9_.\\/-]+)",
        "group": 1,
        "fallbackPattern": "\\b(master|main|dev|develop|release|test)\\b",
        "default": "master"
      }
    },
    "examples": [
      "列出 GitHub 仓库 Michaelxwb/platform-command 的 commits，分支 master"
    ]
  },
  "dataSource": {
    "type": "http_json",
    "title": "GitHub 场景实测：读取指定公开仓库某分支的提交列表。",
    "steps": [
      {
        "id": "commits_api",
        "request": {
          "method": "GET",
          "url": "https://api.github.com/repos/{{params.owner}}/{{params.repo}}/commits?sha={{params.branch}}&per_page=10",
          "headers": {
            "Accept": "application/vnd.github+json",
            "User-Agent": "platform-command-scene-test"
          },
          "successWhen": [
            "status < 400"
          ]
        },
        "collect": {
          "limit": 10,
          "maxPages": 1,
          "itemsPath": "$",
          "map": [
            {
              "path": "sha",
              "key": "sha"
            },
            {
              "path": "commit.message",
              "key": "message"
            },
            {
              "path": "commit.author.name",
              "key": "author"
            },
            {
              "path": "commit.author.date",
              "key": "date"
            },
            {
              "path": "html_url",
              "key": "url"
            }
          ]
        }
      }
    ]
  },
  "output": {
    "capability": "return_json",
    "title": "GitHub 场景实测：读取指定公开仓库某分支的提交列表。"
  }
}
