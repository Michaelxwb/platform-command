{
  "name": "github.list_issues",
  "platform": "github",
  "description": "GitHub 场景实测：读取指定公开仓库的 Issues 列表，支持 state 参数。",
  "riskLevel": "low",
  "sessionRef": "prelogged-github-browser-profile",
  "parameters": {
    "owner": {
      "type": "string",
      "required": false,
      "default": "Michaelxwb",
      "description": "仓库 owner。"
    },
    "repo": {
      "type": "string",
      "required": false,
      "default": "platform-command",
      "description": "仓库名。"
    },
    "state": {
      "type": "string",
      "required": false,
      "default": "all",
      "description": "Issue 状态：open/closed/all。"
    }
  },
  "execution": {
    "prefer": [
      "api",
      "ui"
    ],
    "workflow": {
      "version": "2.0",
      "steps": [
        {
          "id": "issues_api",
          "type": "api",
          "description": "调用 GitHub Issues API 读取 Issues 列表。",
          "request": {
            "method": "GET",
            "url": "https://api.github.com/repos/{{params.owner}}/{{params.repo}}/issues?state={{params.state}}&per_page=10",
            "headers": {
              "Accept": "application/vnd.github+json",
              "User-Agent": "platform-command-scene-test"
            },
            "successWhen": [
              "status < 400"
            ]
          },
          "extract": {
            "firstIssueNumber": "$[0].number",
            "firstIssueTitle": "$[0].title"
          }
        },
        {
          "id": "issues_page",
          "type": "ui",
          "description": "打开仓库 Issues 页面，确认 Issues 标签页可见。",
          "ui": {
            "actions": [
              {
                "action": "goto",
                "url": "https://github.com/{{params.owner}}/{{params.repo}}/issues?q=is%3Aissue+is%3A{{params.state}}"
              },
              {
                "action": "assert",
                "target": "body",
                "contains": "Issues"
              }
            ]
          }
        }
      ]
    }
  },
  "successCriteria": [
    "Issues API 返回 200。",
    "Issues 页面可访问。",
    "state 参数已被带入 API/UI。"
  ],
  "failureCases": [
    "仓库不存在或无权限。",
    "GitHub API 限流。",
    "state 参数不合法。"
  ]
}
