{
  "name": "mss.export_monthly",
  "platform": "mss",
  "description": "MSS 月报业务命令（workflow 组合）：读配置 → 取模板 → 取小语种 → 导出 → 按配置开关同步 portal。report_check=true 时停在人工检查。供 daemon 定时调用或 agent 手动触发。参数仅 companyId。自动发邮件同 export_weekly 说明，由 agent 用 send_email 完成。",
  "riskLevel": "high",
  "parameters": {
    "companyId": { "type": "string", "required": true, "description": "客户 ID（store key）。" }
  },
  "strategy": "sequential",
  "steps": [
    {
      "id": "cfg",
      "command": "mss.display_config",
      "params": { "companyId": "{{params.companyId}}" },
      "extract": { "rangeType": "meta.monthly_range_type", "autoSend": "meta.autoSend", "autoSync": "meta.autoSync", "added": "meta.monthly_emails_added", "removed": "meta.monthly_emails_removed" }
    },
    {
      "id": "tpl",
      "command": "mss.get_template",
      "extract": { "tid": "meta.monthlyId", "tname": "meta.monthlyName" }
    },
    {
      "id": "loc",
      "command": "mss.get_locale",
      "params": { "companyId": "{{params.companyId}}" },
      "extract": { "locale": "meta.localLocale" }
    },
    {
      "id": "export",
      "command": "mss.export_report",
      "dependsOn": ["cfg", "tpl", "loc"],
      "params": {
        "companyId": "{{params.companyId}}",
        "reportType": "monthly",
        "templateId": "{{steps.tpl.tid}}",
        "templateName": "{{steps.tpl.tname}}",
        "rangeType": "{{steps.cfg.rangeType}}",
        "exportConfigKey": "monthly_export_config",
        "locale": "{{steps.loc.locale}}"
      },
      "extract": { "taskId": "meta.taskId" }
    },
    {
      "id": "send",
      "command": "mss.send_email",
      "dependsOn": ["export"],
      "when": "{{steps.cfg.autoSend}}",
      "params": {
        "taskId": "{{steps.export.taskId}}",
        "companyId": "{{params.companyId}}",
        "reportType": "monthly",
        "emailsAdded": "{{steps.cfg.added}}",
        "emailsRemoved": "{{steps.cfg.removed}}"
      }
    },
    {
      "id": "sync",
      "command": "mss.sync_portal",
      "dependsOn": ["export"],
      "when": "{{steps.cfg.autoSync}}",
      "params": {
        "taskId": "{{steps.export.taskId}}",
        "reportType": 3,
        "locale": "{{steps.loc.locale}}"
      }
    }
  ],
  "successCriteria": [
    "顺序执行 配置→模板→小语种→导出→（按 sync_portal 开关）同步。",
    "report_check=true 时由 agent 人工检查。"
  ],
  "checks": ["dry-run 展示 workflow 计划。"],
  "failureCases": ["任一子步失败中止回传。", "导出需 server-mode storageState 会话。"],
  "naturalLanguage": {
    "intent": "一键导出客户月报（并按配置同步）。",
    "aliases": ["导出月报", "跑月报", "生成月报"],
    "match": { "all": ["月报"], "verbs": ["导出", "跑", "生成"] },
    "extract": {
      "companyId": { "type": "after", "pattern": "(?:company_?id|客户id)\\s*(?:是|为|=|:|：)?\\s*([A-Za-z0-9_-]+)" }
    },
    "examples": ["导出客户 123 的月报"]
  }
}
