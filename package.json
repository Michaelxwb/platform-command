{
  "name": "platform-command",
  "version": "0.1.0",
  "description": "A skill for learning platform UI actions, extracting APIs and parameters, then executing reusable commands.",
  "type": "module",
  "bin": {
    "platform-command": "./src/cli.js"
  },
  "scripts": {
    "test": "node tests/run-tests.js",
    "verify:demo": "node src/cli.js verify --command demo.search_example",
    "dry-run:demo": "node src/cli.js execute --command demo.search_example --dry-run keyword=abc"
  },
  "keywords": ["skill", "browser-automation", "api-extraction", "playwright", "command"],
  "author": "GenericAgent",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.52.0"
  }
}
